{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/top3_seedavg_summary.schema.json",
  "title": "Top3 SeedAvg Summary",
  "type": "object",
  "required": [
    "$schema",
    "settings",
    "mix_top3",
    "single_top3",
    "seed_coverage",
    "coverage_gate",
    "top3_policy",
    "statistical_comparisons",
    "outputs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "required": [
        "min_seeds",
        "ranking",
        "allow_fallback",
        "allow_fallback_effective",
        "top3_policy",
        "coverage_gate",
        "schema_validation",
        "required_coverage_ratio",
        "recommended_default",
        "ranking_explanation"
      ],
      "properties": {
        "min_seeds": { "type": "integer", "minimum": 0 },
        "ranking": { "type": "string", "enum": ["mean", "lcb"] },
        "allow_fallback": { "type": "boolean" },
        "allow_fallback_effective": { "type": "boolean" },
        "top3_policy": { "type": "string", "enum": ["strict", "flexible"] },
        "coverage_gate": { "type": "string", "enum": ["off", "warn", "fail"] },
        "schema_validation": { "type": "string", "enum": ["off", "warn", "fail"] },
        "required_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "recommended_default": { "type": "string" },
        "ranking_explanation": {
          "type": "object",
          "required": ["mean", "lcb"],
          "properties": {
            "mean": { "type": "string" },
            "lcb": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mix_top3": { "$ref": "#/$defs/top3Entries" },
    "single_top3": { "$ref": "#/$defs/top3Entries" },
    "seed_coverage": {
      "type": "object",
      "required": ["mix", "single"],
      "properties": {
        "mix": { "$ref": "#/$defs/seedCoverageMap" },
        "single": { "$ref": "#/$defs/seedCoverageMap" }
      },
      "additionalProperties": false
    },
    "coverage_gate": {
      "type": "object",
      "required": ["mix", "single", "gate_mode", "required_coverage_ratio", "passed"],
      "properties": {
        "mix": { "$ref": "#/$defs/coverageGateDataset" },
        "single": { "$ref": "#/$defs/coverageGateDataset" },
        "gate_mode": { "type": "string", "enum": ["off", "warn", "fail"] },
        "required_coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "top3_policy": {
      "type": "object",
      "required": ["policy", "required_top_n", "mix_passed", "single_passed", "passed"],
      "properties": {
        "policy": { "type": "string", "enum": ["strict", "flexible"] },
        "required_top_n": { "type": "integer", "minimum": 1 },
        "mix_passed": { "type": "boolean" },
        "single_passed": { "type": "boolean" },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "statistical_comparisons": {
      "type": "object",
      "required": ["mix", "single"],
      "properties": {
        "mix": { "$ref": "#/$defs/comparisonSummary" },
        "single": { "$ref": "#/$defs/comparisonSummary" }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["mix_plot", "single_plot", "html_report"],
      "properties": {
        "mix_plot": { "type": "string" },
        "single_plot": { "type": "string" },
        "html_report": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "top3Entry": {
      "type": "object",
      "required": [
        "model",
        "strategy",
        "label",
        "ba_mean",
        "ba_std",
        "f1_mean",
        "f1_std",
        "acc_mean",
        "acc_std",
        "n_seeds"
      ],
      "properties": {
        "model": { "type": "string" },
        "strategy": { "type": "string" },
        "label": { "type": "string" },
        "ba_mean": { "type": "number" },
        "ba_std": { "type": "number", "minimum": 0 },
        "f1_mean": { "type": "number" },
        "f1_std": { "type": "number", "minimum": 0 },
        "acc_mean": { "type": "number" },
        "acc_std": { "type": "number", "minimum": 0 },
        "n_seeds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "top3Entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/top3Entry" }
    },
    "seedCoverageMap": {
      "type": "object",
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "coverageGateDataset": {
      "type": "object",
      "required": [
        "min_seeds",
        "total_models",
        "passed_count",
        "failed_count",
        "coverage_ratio",
        "passed_models",
        "failed_models",
        "failed_model_labels",
        "model_max_seed"
      ],
      "properties": {
        "min_seeds": { "type": "integer", "minimum": 0 },
        "total_models": { "type": "integer", "minimum": 0 },
        "passed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "coverage_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "passed_models": { "type": "array", "items": { "type": "string" } },
        "failed_models": { "type": "array", "items": { "type": "string" } },
        "failed_model_labels": { "type": "array", "items": { "type": "string" } },
        "model_max_seed": {
          "type": "object",
          "patternProperties": {
            "^[a-z_][a-z0-9_]*$": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "comparisonSummary": {
      "type": "object",
      "required": ["dataset", "top3_models", "pairwise_comparisons", "comparison_notes"],
      "properties": {
        "dataset": { "type": "string", "enum": ["Mix", "Single"] },
        "top3_models": { "type": "array", "minItems": 1 },
        "pairwise_comparisons": { "type": "array" },
        "comparison_notes": { "type": "object" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
