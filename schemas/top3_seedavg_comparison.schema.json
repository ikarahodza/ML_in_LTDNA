{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/top3_seedavg_comparison.schema.json",
  "title": "Top3 SeedAvg Comparison",
  "type": "object",
  "required": [
    "$schema",
    "dataset",
    "top3_models",
    "pairwise_comparisons",
    "comparison_notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dataset": {
      "type": "string",
      "enum": ["Mix", "Single"]
    },
    "top3_models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "label", "model", "strategy", "ba_mean", "ba_std", "n_seeds"],
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "model": { "type": "string" },
          "strategy": { "type": "string" },
          "ba_mean": { "type": "number" },
          "ba_std": { "type": "number", "minimum": 0 },
          "n_seeds": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "pairwise_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model_a", "model_b", "valid"],
        "properties": {
          "model_a": { "type": "string" },
          "model_a_id": { "type": "string" },
          "model_a_strategy": { "type": "string" },
          "model_a_ba_mean": { "type": "number" },
          "model_b": { "type": "string" },
          "model_b_id": { "type": "string" },
          "model_b_strategy": { "type": "string" },
          "model_b_ba_mean": { "type": "number" },
          "n_paired_seeds": { "type": "integer", "minimum": 0 },
          "mean_difference": { "type": "number" },
          "std_difference": { "type": "number" },
          "paired_t_test": {
            "type": "object",
            "properties": {
              "t_statistic": { "type": "number" },
              "p_value": { "type": "number" },
              "valid": { "type": "boolean" },
              "note": { "type": "string" }
            },
            "required": ["valid"],
            "additionalProperties": false
          },
          "wilcoxon_test": {
            "type": "object",
            "properties": {
              "statistic": { "type": "number" },
              "p_value": { "type": "number" },
              "valid": { "type": "boolean" },
              "note": { "type": "string" }
            },
            "required": ["valid"],
            "additionalProperties": false
          },
          "cohens_d": {
            "anyOf": [
              { "type": "number" },
              { "type": "null" }
            ]
          },
          "ci_95_lower": { "type": "number" },
          "ci_95_upper": { "type": "number" },
          "significantly_different_ttest": { "type": "boolean" },
          "significantly_different_wilcoxon": { "type": "boolean" },
          "reason": { "type": "string" },
          "valid": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "valid": { "const": true } },
              "required": ["valid"]
            },
            "then": {
              "required": [
                "model_a_id",
                "model_a_strategy",
                "model_a_ba_mean",
                "model_b_id",
                "model_b_strategy",
                "model_b_ba_mean",
                "n_paired_seeds",
                "mean_difference",
                "std_difference",
                "paired_t_test",
                "wilcoxon_test",
                "cohens_d",
                "ci_95_lower",
                "ci_95_upper",
                "significantly_different_ttest",
                "significantly_different_wilcoxon"
              ]
            }
          },
          {
            "if": {
              "properties": { "valid": { "const": false } },
              "required": ["valid"]
            },
            "then": {
              "required": ["reason"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "comparison_notes": {
      "type": "object",
      "required": ["paired_tests", "significance_threshold", "cohens_d_interpretation"],
      "properties": {
        "paired_tests": { "type": "string" },
        "significance_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "cohens_d_interpretation": {
          "type": "object",
          "required": ["small", "medium", "large"],
          "properties": {
            "small": { "type": "number" },
            "medium": { "type": "number" },
            "large": { "type": "number" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
